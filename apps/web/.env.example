# Required
HELIUS_API_KEY=            # mainnet RPC, enhanced transactions, DAS prices, webhooks
SESSION_SECRET=            # 32+ random chars; signs sessions and nonces
DATABASE_URL=              # Postgres (Neon). Without it, local dev uses embedded PGlite in .data/

# Real-time monitoring (production)
WARDEN_PUBLIC_URL=         # https origin, e.g. https://warden.example.com (enables the Helius webhook)
WEBHOOK_SECRET=            # shared secret Helius sends back in the Authorization header
CRON_SECRET=               # Vercel Cron bearer token for /api/cron/sync

# Optional
HELIUS_API_KEY_BACKUP=
ANTHROPIC_API_KEY=         # intent check; without it, checks that need intent are held (fail closed)
WARDEN_INTENT_MODEL=claude-haiku-5-5
TELEGRAM_BOT_TOKEN=        # enables Telegram alert channels
WARDEN_REVIEWERS=          # comma-separated owner addresses allowed to confirm Threat Network reports
NEXT_PUBLIC_CONTACT_EMAIL=      # shown as the "Contact us" button on the site
